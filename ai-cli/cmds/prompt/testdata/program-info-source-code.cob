008297***********************
008298 UT-VERIF-ALLINEAMENTO.
008299***********************
008300     MOVE '*** UT-VERIF-ALLINEAMENTO' TO WS-MESSAGGIO
008301     PERFORM TRACCIA
008302*
008303     SET WS-NO-ALLINEAMENTO-STD       TO TRUE
008304     SET WS-NO-TROVATO-COMPAD         TO TRUE
008305*
008306     PERFORM VARYING WP-IND FROM 1 BY 1
008307       UNTIL WP-IND > WP-INDM
008308          OR WS-SI-ALLINEAMENTO-STD
008309* SE APPLICATO NON DI ISTITUTO, PREPARAZIONE TAB. PER VERIFICA
008310* ED EV. ALLINEAMENTO A STD
008311        IF NOT (WP-CDAPPLIV(WP-IND) = 'S' OR 'Q')
008312           SET WS-SI-ALLINEAMENTO-STD TO TRUE
008313        END-IF
008314     END-PERFORM
008315*
008316* RICERCA COMPONENTE A SPR - QUALIFICATORE IN CNGR
008317     IF WS-SI-ALLINEAMENTO-STD
008318        MOVE ZEROES                   TO WG-IND-RIF
008319        PERFORM VARYING WG-IND FROM 1 BY 1
008320          UNTIL WG-IND > WG-INDM
008321             OR WG-IND-RIF > ZEROES
008322           IF WG-IDCOMP(WG-IND) = WA-IDCOMP
008323              MOVE WG-IND             TO WG-IND-RIF
008324           END-IF
008325        END-PERFORM
008326        IF WG-IND-RIF = ZEROES
008327* ... CARICO TABELLE CONGRUENZE
008328           PERFORM UT-CARICA-CNGR
008329           IF  C6SP01A-CDESITO = SPACES
008330           AND WS-NO-TROVATO-COMPAD
008331              PERFORM UT-CARICA-VALORI-INDICE
008332           END-IF
008333* ... CARICO TABELLE VALORI DI STANDARD PER ALLINEAMENTO
008334           IF C6SP01A-CDESITO = SPACES
008335              PERFORM UT-CARICA-VAL-ALLSTD
008336           END-IF
008337           IF C6SP01A-CDESITO = SPACES
008338              MOVE WG-INDM            TO WG-IND-RIF
008339           END-IF
008340        END-IF
008341        MOVE SPACES TO WS-MESSAGGIO
008342        STRING '    ---> WG-IND-RIF >' WG-IND-RIF '<'
008343                DELIMITED BY SIZE   INTO WS-MESSAGGIO
008344        PERFORM TRACCIA
008345     END-IF.
008346*
008347* ALLINEAMENTO ALLO STD
008348     IF  C6SP01A-CDESITO = SPACES
008349     AND WS-SI-ALLINEAMENTO-STD
008350     AND WG-IND-RIF > ZEROES
008351        MOVE 1                        TO WP-IND
008352        MOVE WG-IND-DA(WG-IND-RIF)    TO WK-IND
008353        PERFORM UNTIL WP-IND > WP-INDM
008354                   OR C6SP01A-CDESITO > SPACES
008355           IF WP-CDAPPLIV(WP-IND) = 'S' OR 'Q'
008356              ADD 1                   TO WP-IND
008357           ELSE
008358              IF WK-DTFINE(WK-IND) < WP-DTINIZIO(WP-IND)
008359                 ADD 1                TO WK-IND
008360              ELSE
008361* VERIFICA SUPERAMENTO STANDARD
008362                 IF (WA-CDESTREM = 'S'
008363                 AND WA-SNSUPSTD = 'S'
008364                 AND WP-CDVALNUM(WP-IND) > WK-NRVAL(WK-IND))
008365                 OR (WA-CDESTREM = 'I'
008366                 AND WA-SNSUPSTD = 'S'
008367                 AND WP-CDVALNUM(WP-IND) < WK-NRVAL(WK-IND))
008368                    PERFORM UT-ISOLA-RANGE-WP
008369                    IF C6SP01A-CDESITO = SPACES
008370* ABBATTIMENTO RANGE CORRENTE E PASSAGGIO AL PROSSIMO RANGE
008371                       MOVE WK-NRVAL(WK-IND)
008372                                      TO WP-CDVALNUM(WP-IND)
008373                       ADD 1          TO WP-IND
008374                    END-IF
008375                 ELSE
008376                    IF WP-DTFINE(WP-IND) <= WK-DTFINE(WK-IND)
008377                       ADD 1          TO WP-IND
008378                    ELSE
008379                       ADD 1          TO WK-IND
008380                    END-IF
008381                 END-IF
008382              END-IF
008383           END-IF
008384        END-PERFORM
008385     END-IF.
008386*
008387*******************
008388 UT-ISOLA-RANGE-WP.
008389*******************
008390* ISOLA IL RANGE DEL VALORE DA ABBATTERE, CREANDO EVENTUALMENTE
008391* NUOVE SPEZZATURE TRA I VALORI
008392*
008393* N.B.: VISTO CHE I RANGE STD SONO CONTIGUI, LADDOVE HO NECESSITA'
008394*       DI FARE CALCOLI SULLE DATE, POSSO INVECE PRENDERE LA DATA
008395*       FINE DELL'OCCORRENZA STD PRECEDENTE O LA DATA INIZIO
008396*       DELL'OCCORRENZA STD SUCCESSIVA
008397*
008398     IF  WP-DTINIZIO(WP-IND) < WK-DTINIZIO(WK-IND)
008399     AND WP-DTFINE(WP-IND)  >= WK-DTINIZIO(WK-IND)
008400* 1A) CREAZIONE SPAZIO WP PER ISOLARE INTERVALLO ANTE STD
008401        PERFORM UT-CREA-SPAZIO-WP
008402* 2A) CONSOLIDAMENTO RECORD CORRENTE
008403        IF C6SP01A-CDESITO = SPACES
008404           MOVE WK-DTFINE(WK-IND - 1)   TO WP-DTFINE(WP-IND)
008405* 3A) PASSO AL RANGE SUCCESSIVO E SISTEMO LA DATA INIZIO
008406           ADD 1                        TO WP-IND
008407           MOVE WK-DTINIZIO(WK-IND)     TO WP-DTINIZIO(WP-IND)
008408* 4A) CREAZIONE SPAZIO WP PER ISOLARE INTERVALLO POST STD
008409           IF WP-DTFINE(WP-IND) > WK-DTFINE(WK-IND)
008410              PERFORM UT-CREA-SPAZIO-WP
008411              IF C6SP01A-CDESITO = SPACES
008412                 MOVE WK-DTFINE(WK-IND) TO WP-DTFINE(WP-IND)
008413                 MOVE WK-DTINIZIO(WK-IND + 1)
008414                                        TO WP-DTINIZIO(WP-IND + 1)
008415              END-IF
008416           END-IF
008417        END-IF
008418     ELSE
008419        IF  WP-DTINIZIO(WP-IND) < WK-DTFINE(WK-IND)
008420        AND WP-DTFINE(WP-IND)  >= WK-DTFINE(WK-IND)
008421* 1B) CREAZIONE SPAZIO WP PER ISOLARE INTERVALLO POST STD
008422           PERFORM UT-CREA-SPAZIO-WP
008423           IF C6SP01A-CDESITO = SPACES
008424              MOVE WK-DTFINE(WK-IND)    TO WP-DTFINE(WP-IND)
008425* 2B) SISTEMO LA DATA INIZIO DEL PROSSIMO INTERVALLO
008426              MOVE WK-DTINIZIO(WK-IND + 1)
008427                                        TO WP-DTINIZIO(WP-IND + 1)
008428           END-IF
008429        END-IF
008430     END-IF.
