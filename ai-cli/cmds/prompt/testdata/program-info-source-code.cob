006992*CARICA-TABOUT.
006993**************
006994*    MOVE SPACES TO WS-MESSAGGIO
006995*    STRING ">>> CARICA-TABOUT (WP-INDM " WP-INDM ")"
006996*            DELIMITED BY SIZE INTO WS-MESSAGGIO
006997*    PERFORM TRACCIA
006998*
006999*    PERFORM VARYING WP-IND FROM 1 BY 1
007000*      UNTIL WP-IND > WP-INDM
007001*         OR C6SP01A-CDESITO > SPACES
007002*         OR WS-SI-FINE-RIPARTENZA
007003*
007004*       IF WP-IND = 1
007005*       OR WP-CDVALALF(WP-IND) NOT = WP-CDVALALF(WP-IND - 1)
007006*       OR WP-CDVALNUM(WP-IND) NOT = WP-CDVALNUM(WP-IND - 1)
007007*       OR WP-CDAPPLIV(WP-IND) NOT = WP-CDAPPLIV(WP-IND - 1)
007008*       OR WP-CDINDICE(WP-IND) NOT = WP-CDINDICE(WP-IND - 1)
007009*          IF C6SP01A-ELDIMOUT-OUT = WS-IND-MAX
007010*             IF C6SP01A-CDKEYRIP > SPACES
007011*                MOVE "E098" TO C6SP01A-CDESITO
007012*                MOVE "SFONDAMENTO TAB.OUTPUT"
007013*                               TO C6SP01A-DSERTEXT-BREVE
007014*                MOVE "SFONDAMENTO TAB.OUTPUT"
007015*                               TO C6SP01A-DSERTEXT-MEDIO
007016*             ELSE
007017*                SET WS-SI-FINE-RIPARTENZA TO TRUE
007018*             END-IF
007019*          ELSE
007020*             IF C6SP01A-CDKEYRIP <= SPACES
007021*             OR (C6SP01A-CDKEYRIP > SPACES
007022*             AND WS-IND-RIP >= WS-IND-MAX)
007023*                ADD 1                 TO  C6SP01A-ELDIMOUT-OUT
007024*                MOVE WA-DSCDZBR
007025*                  TO C6SP01A-DSCDZBR-OUT (C6SP01A-ELDIMOUT-OUT)
007026*                MOVE WA-DSLEGBR
007027*                  TO C6SP01A-DSLEGBR-OUT (C6SP01A-ELDIMOUT-OUT)
007028*                MOVE WA-NRPRELEM
007029*                  TO C6SP01A-NRPRELEM-OUT (C6SP01A-ELDIMOUT-OUT)
007030*                MOVE WA-NRPRREGO
007031**                 TO C6SP01A-NRPREGOL-OUT (C6SP01A-ELDIMOUT-OUT)
007032*                MOVE WA-CDNATCDZ
007033**                 TO C6SP01A-CDNATCDZ-OUT (C6SP01A-ELDIMOUT-OUT)
007034*                IF  WA-CDSPREAD = "S"
007035*                AND C6SP01A-CDUTISPR = "1"
007036*                   MOVE "N"
007037*                  TO C6SP01A-CDFORVAL-OUT (C6SP01A-ELDIMOUT-OUT)
007038*                ELSE
007039*                   MOVE WA-CDTPFORM
007040*                  TO C6SP01A-CDFORVAL-OUT (C6SP01A-ELDIMOUT-OUT)
007041**               END-IF
007042*                MOVE WA-NRDIMENS
007043*                  TO C6SP01A-NMDIMEN-OUT (C6SP01A-ELDIMOUT-OUT)
007044*                MOVE WA-NRDECIM
007045*                  TO C6SP01A-NMDECIMA-OUT (C6SP01A-ELDIMOUT-OUT)
007046*                MOVE WA-NRPRIOR
007047*                  TO C6SP01A-NRPRCOMP-OUT (C6SP01A-ELDIMOUT-OUT)
007048*
007049*                STRING WP-DTINIZIO(WP-IND)(1:4)
007050*                       WP-DTINIZIO(WP-IND)(6:2)
007051*                       WP-DTINIZIO(WP-IND)(9:2)
007052*                       DELIMITED BY SIZE INTO
007053*                       C6SP01A-DTINIVAL-OUT(C6SP01A-ELDIMOUT-OUT)
007054*                IF WP-DTFINE(WP-IND) >= "9999-12-31"
007055*                   MOVE 99999999
007056**                   TO C6SP01A-DTFINVAL-OUT(C6SP01A-ELDIMOUT-OUT)
007057*                ELSE
007058*                   STRING WP-DTFINE(WP-IND)(1:4)
007059*                          WP-DTFINE(WP-IND)(6:2)
007060*                          WP-DTFINE(WP-IND)(9:2)
007061*                          DELIMITED BY SIZE INTO
007062*                       C6SP01A-DTFINVAL-OUT(C6SP01A-ELDIMOUT-OUT)
007063*                END-IF
007064*                MOVE WP-CDVALALF(WP-IND)
007065*                  TO C6SP01A-DSVAL-OUT (C6SP01A-ELDIMOUT-OUT)
007066*                MOVE WP-CDVALNUM(WP-IND)
007067*                  TO C6SP01A-NRVAL-OUT (C6SP01A-ELDIMOUT-OUT)
007068*                MOVE WP-CDINDICE(WP-IND)
007069*                  TO C6SP01A-CDINDICE-OUT (C6SP01A-ELDIMOUT-OUT)
007070*                MOVE WP-CDAPPLIV(WP-IND)
007071*                  TO C6SP01A-CDAPPLIV-OUT (C6SP01A-ELDIMOUT-OUT)
007072*                IF WA-CDSPREAD = "I"
007073*                   IF WI-INDM >= WI-IND-MAX
007074*                      MOVE "E098"       TO C6SP01A-CDESITO
007075*                      MOVE "SFONDAMENTO TAB.APP WI"
007076*                                        TO C6SP01A-DSERTEXT-BREVE
007077*                      MOVE "SFONDAMENTO TAB.APP WI"
007078*                                        TO C6SP01A-DSERTEXT-MEDIO
007079*                   ELSE
007080*                      ADD 1              TO WI-INDM
007081*                      MOVE WP-DTINIZIO(WP-IND)
007082*                        TO WI-DTINIZIO(WI-INDM)
007083*                      MOVE WP-DTFINE (WP-IND)
007084*                        TO WI-DTFINE (WI-INDM)
007085*                      MOVE WP-CDVALALF(WP-IND)
007086*                        TO WI-CDINDICE(WI-INDM)
007087*                   END-IF
007088*                END-IF
007089*             ELSE
007090*                IF C6SP01A-CDKEYRIP > SPACES
007091*                   ADD 1             TO WS-IND-RIP
007092*                END-IF
007093*             END-IF
007094*          END-IF
007095*       ELSE
007096*  COMPATTAMENTO
007097*          IF C6SP01A-ELDIMOUT-OUT > ZEROES
007098*             IF WP-DTFINE(WP-IND) >= "9999-12-31"
007099*                MOVE 99999999
007100*                 TO C6SP01A-DTFINVAL-OUT(C6SP01A-ELDIMOUT-OUT)
007101*             ELSE
007102*                STRING WP-DTFINE(WP-IND)(1:4)
007103*                       WP-DTFINE(WP-IND)(6:2)
007104*                       WP-DTFINE(WP-IND)(9:2)
007105*                       DELIMITED BY SIZE INTO
007106*                    C6SP01A-DTFINVAL-OUT(C6SP01A-ELDIMOUT-OUT)
007107*             END-IF
007108*             IF WA-CDSPREAD = "I"
007109*                MOVE WP-DTFINE (WP-IND) TO WI-DTFINE (WI-INDM)
007110*             END-IF
007111*          END-IF
007112*       END-IF
007113*    END-PERFORM
007114*
007115*    IF WS-SI-FINE-RIPARTENZA
