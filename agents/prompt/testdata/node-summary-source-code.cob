008990
008994
008995        IF W-INDS-CONTATORE-TOT NOT = ZEROES
008996           COMPUTE W-INDS-DA(W-INDX) =  W-INDS-DA(W-INDX) +
008997                                         W-INDS-CONTATORE-TOT
008998           COMPUTE W-INDS-A(W-INDX) =   W-INDS-A(W-INDX) +
008999                                         W-INDS-CONTATORE-TOT
